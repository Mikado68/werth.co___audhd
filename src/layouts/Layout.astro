---
import Grid from "@mui/material/Grid";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <Grid container spacing={2}>
      <slot />
    </Grid>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 16px;
    width: calc(100%-16px);
    max-width: 1500px;
    height: 100%;
    background-color: var(--purple-dark);
  }
</style>

<style is:global>
  :root {
    --purple-light: hsl(293, 10%, 50%);
    --purple-main: hsl(293, 17%, 30%);
    --purple-dark: hsl(290, 6%, 20%);

    --lila-light: hsl(300, 15%, 90%);
    --lila-main: hsl(300, 15%, 70%);
    --lila-dark: hsl(300, 15%, 60%);

    --beige-light: hsl(55, 30%, 95%);
    --beige-main: hsl(55, 30%, 90%);
    --beige-dark: hsl(55, 30%, 30%);

    --lightpink-light: hsl(6, 54%, 99%);
    --lightpink-main: hsl(6, 54%, 89%);
    --lightpink-dark: hsl(6, 54%, 19%);

    --pink-main: hsl(348, 54%, 99%);
    --pink-dark: hsl(348, 54%, 89%);
    --pink-dark: hsl(348, 54%, 19%);

    --spacing-unit: 16px;

    --error-light: rgb(255, 177, 177);
    --error-dark: rgb(141, 32, 32);

    --error-light: hsl(0, 70%, 90%);
    --error-main: hsl(0, 70%, 40%);
    --error-dark: hsl(0, 70%, 20%);

    --success-light: hsl(125, 70%, 90%);
    --success-main: hsl(125, 70%, 40%);
    --success-dark: hsl(125, 70%, 20%);
  }

  .MuiAlert-root {
    border-width: 1px !important;
    border-style: solid !important;
    border-radius: 0 !important;
  }

  .MuiAlert-colorError {
    color: var(--error-dark) !important;
    border-color: var(--error-dark) !important;
    background-color: var(--error-light) !important;

    .MuiSvgIcon-root {
      color: var(--error-dark) !important;
    }
  }

  .MuiAlert-colorSuccess {
    color: var(--success-dark) !important;
    border-color: var(--success-dark) !important;
    background-color: var(--success-light) !important;

    .MuiSvgIcon-root {
      color: var(--success-dark) !important;
    }
  }
</style>
