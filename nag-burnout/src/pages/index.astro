---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";

const burnoutEntries = (await getCollection("burnout")).filter((entry) =>
  Boolean(entry.data.title),
);
---

<Layout>
  <main>
    <section class="grid space-y-8">
      {burnoutEntries.map((entry) => <Card data={entry.data} />)}
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: 2rem;
    color: #111827;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
